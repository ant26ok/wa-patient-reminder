# Port Server
PORT=3003

# Mekari Qontak Official WhatsApp API
# Dapatkan kredensial dari dashboard Qontak (Settings -> Integrations -> WhatsApp)
QONTAK_BASE_URL=https://service-chat.qontak.com/api/open/v1
QONTAK_TOKEN=your_qontak_bearer_token_here
QONTAK_CHANNEL_INTEGRATION_ID=your_channel_integration_id_here
QONTAK_TEMPLATE_ID=your_approved_template_id_here
